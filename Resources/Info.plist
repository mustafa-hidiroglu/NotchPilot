<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy usage descriptions:
  * NSSpeechRecognitionUsageDescription: shown in the Speech Recognition prompt the first
    time the person starts capture. Recognition is on-device only (no server fallback).
  * Deliberately no NSMicrophoneUsageDescription / NSCameraUsageDescription: NotchPilot
    never touches the microphone or camera. System audio and the optional on-demand
    screenshot use ScreenCaptureKit, whose "Screen & System Audio Recording" permission
    has no Info.plist key (macOS shows its own prompt).
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>app.notchpilot.NotchPilot</string>
    <key>CFBundleName</key>
    <string>NotchPilot</string>
    <key>CFBundleDisplayName</key>
    <string>NotchPilot</string>
    <key>CFBundleExecutable</key>
    <string>NotchPilot</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>NotchPilot transcribes the audio your Mac plays, on this Mac, so it can answer questions about it. Audio never leaves your Mac.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 NotchPilot. All rights reserved.</string>
</dict>
</plist>
